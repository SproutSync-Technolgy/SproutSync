# Copy to .env at the REPOSITORY ROOT. Fill all five required values.
# Use ONE development Supabase project for database, Auth, and browser.
# Get the SQLAlchemy/psycopg URL from Supabase Connect (direct/session pooler).
# URL-encode special characters in the password; use sslmode=require for hosted DBs.
# Alembic migrations should not use transaction pooling.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Public browser values must match the two server values above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local browser origin. Keep localhost consistent for OAuth redirects.
FRONTEND_URL=http://localhost:5173

# Optional SERVER ONLY: syncing admin email corrections to Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=

# Optional SERVER ONLY: FastAPI verification-email endpoints.
# Supabase Auth emails use separate SMTP settings in the Supabase dashboard.
GOOGLE_SMTP_EMAIL=
GOOGLE_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional full LOCAL Supabase stack: containers reach the host through
# host.docker.internal using the ports reported by `supabase status`.
# Leave blank for hosted Supabase. Never put secrets in VITE_ variables.
DOCKER_DATABASE_URL=
DOCKER_SUPABASE_URL=

# Optional standalone infrastructure profile; NOT a full Supabase installation.
POSTGRES_DB=sproutsync
POSTGRES_USER=sproutsync
POSTGRES_PASSWORD=local-development-only
