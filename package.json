{
  "name": "sproutsync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check:setup": "node scripts/check-setup.mjs",
    "test:setup": "node --test scripts/check-setup.test.mjs",
    "test:setup:browser": "node scripts/smoke-setup-browser.mjs",
    "predev": "npm run check:setup",
    "dev": "npm run dev -w @sproutsync/dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
